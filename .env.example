# JobHunter AI Local Environment Settings

# Backend URL (React frontend calls this)
BACKEND_URL=http://localhost:8000

# SQLite Database Connection URL
# Relative path inside the backend folder structure
DATABASE_URL=sqlite:///./jobhunter.db

# Google Gemini API key (Required for Phase 1+)
GEMINI_API_KEY=your_gemini_api_key_here

# Adzuna API credentials (Optional, for Phase 2+ Adzuna search)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=us

# Backend logger logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
